  "meta": {
    "title": "Global AI Adoption Index",
    "as_of": "2026-04-28",
    "version": "1.0.0",
    "description": "Composite country-level index (0-100) blending enterprise AI adoption, generative-AI consumer usage, government readiness, talent & skills, and AI investment / infrastructure. Estimates are projected from the most recent published sources and should be treated as directional, not authoritative.",
    "sources": [
      {"name": "Stanford HAI - AI Index Report 2025", "url": "https://aiindex.stanford.edu/report/"},
      {"name": "McKinsey - The State of AI 2024", "url": "https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai"},
      {"name": "IBM - Global AI Adoption Index 2024", "url": "https://www.ibm.com/think/insights/ai-adoption"},
      {"name": "IMF - AI Preparedness Index (AIPI) 2024", "url": "https://www.imf.org/en/Publications/WP/Issues/2024/06/14/Mapping-the-World-s-Readiness-for-Artificial-Intelligence-549706"},
      {"name": "Tortoise Media - Global AI Index 2024", "url": "https://www.tortoisemedia.com/intelligence/global-ai/"},
      {"name": "Oxford Insights - Government AI Readiness Index 2024", "url": "https://oxfordinsights.com/ai-readiness/ai-readiness-index/"},
      {"name": "Stanford / Ipsos - Global GenAI Usage Survey 2024-2025"},
      {"name": "OECD.AI - National AI policies & investments"}
    ],
    "methodology": "Composite = 0.30 enterprise_adoption + 0.20 consumer_genai_use + 0.20 government_readiness + 0.15 talent_skills + 0.15 investment_infrastructure. All sub-scores normalised 0-100 from latest published values, with linear extrapolation through Q1 2026 using 2023->2024 deltas. Composite values are estimates."
  },
